# ─────────────────────────────────────────────────────────────
#  Variables de entorno del BOT de Instagram de MAGA
#  Copiá este archivo como .env y completá los valores reales.
#  En Vercel, cargá estas mismas variables en Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Claude (API de Anthropic) ---
# Tu API key de https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar. Por defecto claude-opus-5.
# Para bajar costos en un bot de alto volumen podés usar:
#   claude-sonnet-5   (más barato, muy bueno)
#   claude-haiku-4-5  (el más barato y rápido)
CLAUDE_MODEL=claude-opus-5

# --- Meta / Instagram ---
# Token que vos inventás; debe coincidir con el que pongas en la config del
# webhook en el panel de Meta for Developers.
META_VERIFY_TOKEN=un-token-secreto-que-elegis-vos

# App Secret de tu app de Meta (Settings → Basic). Se usa para verificar la
# firma de los webhooks. Muy recomendado en producción.
META_APP_SECRET=

# Access token de la cuenta de Instagram (con permisos instagram_manage_messages).
IG_ACCESS_TOKEN=

# Id de tu cuenta de Instagram profesional (para ignorar tus propios mensajes).
IG_ACCOUNT_ID=

# --- Auto-renovación del token (recomendado) ---
# Base de datos Upstash Redis (plan gratis) donde se guarda el token renovado.
# Las obtenés al crear una base en https://upstash.com (sección REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Clave secreta que protege el endpoint de renovación (inventá cualquier texto).
# Vercel la usa automáticamente para autenticar el cron.
CRON_SECRET=

# --- Opcionales (avanzado) ---
# Base de la Graph API. Por defecto: https://graph.instagram.com
# Si conectaste vía Página de Facebook, usá: https://graph.facebook.com
# META_GRAPH_BASE=https://graph.instagram.com
# META_GRAPH_VERSION=v21.0
